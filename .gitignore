# secrets — never commit credentials
*.json
!.devcontainer/*.json
.streamlit/secrets.toml
*service_account*
light-rhythm-*

# python
__pycache__/
*.pyc
.venv/
venv/

# local artifacts
*.png
~$*.xlsx
sheet_backup_*/
updated_masters/

# TALLEC operational data — local only, never committed
# _backups holds full copies of tallec.db taken before every guarded write
# (450 MB at eight retained snapshots), and the audit log is per-machine.
_backups/
tallec/_backups/
tallec_audit.db
tallec/tallec_audit.db

# TALLEC code lives in TALLEC/ and its data does not. The databases carry licensed
# Stats Perform rows and dates of birth for about three thousand named players, and this
# repository is public, so they stay local. See TALLEC/DATA_NOT_IN_GIT.md.
*.db
TALLEC/_backups/

# `*.json` above is a blanket rule for credentials, and it would silently swallow two
# files TALLEC cannot run without: its configuration and the sealed holdout record that
# pins the project's only untouched out-of-sample result. Named back in explicitly.
!TALLEC/config.json
!TALLEC/MANIFEST.json
!TALLEC/v1_holdout_record.json
# the dashboard's data file; tallec_dashboard.html is useless without it
!TALLEC/dash_data.json
!TALLEC/.claude/launch.json
